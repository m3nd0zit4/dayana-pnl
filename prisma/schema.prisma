model MessageLog {
  id           String         @id @default(cuid())
  contactId    String         @map("contact_id")
  templateId   String?        @map("template_id")
  staffUserId  String?        @map("staff_user_id")
  channel      MessageChannel @default(WHATSAPP_LINK)
  bodySnapshot String         @map("body_snapshot") @db.Text
  sentAt       DateTime       @default(now()) @map("sent_at")

  /// Estado de conversación de WhatsApp Cloud API (entrada y salida).
  direction         MessageDirection      @default(OUTBOUND)
  status            MessageDeliveryStatus @default(SENT)
  providerMessageId String?               @map("provider_message_id")
  waContextId       String?               @map("wa_context_id")
  mediaUrl          String?               @map("media_url")
  deliveredAt       DateTime?             @map("delivered_at")
  readAt            DateTime?             @map("read_at")

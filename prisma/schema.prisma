generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContactSource {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  WEB
  WEB_LEAD_FORM
  WHATSAPP_DIRECT
  REFERRAL
  OTHER
}

enum ProductKind {
  THERAPY
  COURSE
  WORKSHOP
}

enum EnrollmentStatus {
  LEAD
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  PAYPAL
  MERCADO_PAGO
  MANUAL
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
  REFUNDED
}

enum TherapySessionStatus {
  PENDING_SCHEDULE
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

enum NotebookPageKind {
  CANVAS
  UPLOAD
}

enum NotebookPageBackground {
  BLANK
  RULED
  GRID
}

enum WorkshopEditionStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
}

enum StaffRole {
  OWNER
  OPERATOR
  READONLY
  DEVELOPER
}

enum MemberAuthTokenPurpose {
  INVITE
  PASSWORD_RESET
}

enum MessageChannel {
  WHATSAPP_LINK
  WHATSAPP_API
  EMAIL
  SMS
  INTERNAL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationCampaignStatus {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

/// Canal de Meta de un hilo de la bandeja de entrada.
enum ConversationChannel {
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

enum ConversationStatus {
  OPEN
  /// Respondimos y esperamos al cliente.
  PENDING
  CLOSED
}

/// Servicio de Google que una cuenta conectada expone al agente.
///
/// Cada servicio añade sus propios scopes al consentimiento, así que activar
/// uno nuevo sobre una cuenta ya conectada obliga a volver a autorizarla.
enum GoogleService {
  CALENDAR
  CONTACTS
  DRIVE
}

/// Red social conectada para publicar contenido.
enum SocialProvider {
  TIKTOK
  INSTAGRAM
  FACEBOOK
}

enum SocialMediaType {
  VIDEO
  PHOTO
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  /// Reclamado por el worker; impide que dos ejecuciones publiquen lo mismo.
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

enum RecordingStatus {
  NONE
  UPLOADING
  PROCESSING
  READY
  ERRORED
}

/// Qué tipo de contenido es este item dentro del módulo — antes solo existían
/// clases de video; ahora un módulo puede mezclar video, lectura, material
/// descargable y cuestionarios.
enum LessonContentType {
  VIDEO
  TEXT
  PDF
  QUIZ
}

/// Catálogo de eventos de la plataforma. La etiqueta, la descripción y los
/// valores por defecto viven en lib/notifications/platform/catalog.ts — este
/// enum solo garantiza integridad referencial.
enum NotificationEventType {
  // Pagos y ventas
  PAYMENT_APPROVED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  MANUAL_PAYMENT_RECORDED
  PAYMENT_WEBHOOK_FAILED
  // Embudo e inscripciones
  LEAD_CREATED
  WEB_LEAD_SUBMITTED
  ENROLLMENT_PENDING_PAYMENT
  ENROLLMENT_ACTIVATED
  ENROLLMENT_STATUS_CHANGED
  CHECKOUT_ABANDONED
  LEAD_STALE
  // Terapias
  THERAPY_SESSION_SCHEDULED
  THERAPY_SESSION_RESCHEDULED
  THERAPY_SESSION_COMPLETED
  THERAPY_SESSION_NO_SHOW
  // Curso y membresía
  MEMBER_SIGNED_UP
  MEMBERSHIP_DUE_SOON
  MEMBERSHIP_OVERDUE
  MEMBERSHIP_EXTENDED
  LESSON_COMMENT_POSTED
  CLASS_RECORDING_PUBLISHED
  // Sistema, seguridad y comunicación
  LOGIN_FAILED
  LOGIN_SUCCEEDED
  STAFF_USER_CREATED
  AGENT_ACTION_EXECUTED
  CAMPAIGN_COMPLETED
  NOTIFICATION_DELIVERY_FAILED
  SYSTEM_ALERT
  // Bandeja de entrada
  INBOX_MESSAGE_RECEIVED
  // Publicación en redes
  SOCIAL_POST_PUBLISHED
  SOCIAL_POST_FAILED
}

model Contact {
  id                  String        @id @default(cuid())
  phoneE164           String        @unique @map("phone_e164")
  phoneCountryIso     String?       @map("phone_country_iso") @db.Char(2)
  email               String?       @unique
  firstName           String        @map("first_name")
  lastName            String?       @map("last_name")
  displayName         String?       @map("display_name")
  countryIso          String?       @map("country_iso") @db.Char(2)
  timezone            String        @default("America/Bogota")
  preferredLocale     String        @default("es") @map("preferred_locale")
  avatarUrl           String?       @map("avatar_url")
  workDescription     String?       @map("work_description")
  themePreference     String        @default("system") @map("theme_preference")
  notifyEmail         Boolean       @default(true) @map("notify_email")
  notifySms           Boolean       @default(true) @map("notify_sms")
  notifyWhatsapp      Boolean       @default(true) @map("notify_whatsapp")
  notifyInApp         Boolean       @default(true) @map("notify_in_app")
  source              ContactSource @default(WEB)
  sourceDetail        String?       @map("source_detail")
  tiktokHandle        String?       @map("tiktok_handle")
  notes               String?       @db.Text
  consentDataAt       DateTime?     @map("consent_data_at")
  consentMarketingAt  DateTime?     @map("consent_marketing_at")
  /// Consentimiento para medición publicitaria (Meta CAPI, Google Ads).
  /// Deliberadamente separado de `consentMarketingAt`: aceptar recibir
  /// comunicaciones comerciales no es aceptar que se envíen datos a
  /// plataformas de anuncios. Sin esta fecha, CAPI no envía nada de este
  /// contacto — el envío desde servidor recupera señal que el navegador
  /// bloquea por motivos técnicos, no consentimiento que el usuario negó.
  consentAdTrackingAt DateTime?     @map("consent_ad_tracking_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  enrollments            Enrollment[]
  tags                   ContactTag[]
  messageLogs            MessageLog[]
  notificationDeliveries NotificationDelivery[]
  notificationRecipients NotificationRecipient[]
  notebookPages          ContactNotebookPage[]
  memberAccount          MemberAccount?
  memberAuthTokens       MemberAuthToken[]
  moduleProgress         CourseModuleProgress[]
  classProgress          CourseClassProgress[]
  lessonComments         LessonComment[]
  conversations          Conversation[]
  channelIdentities      ContactChannelIdentity[]
  webinarRegistrations   WebinarRegistration[]

  @@index([createdAt])
  @@index([countryIso])
  @@index([consentMarketingAt])
  @@map("contacts")
}

model Product {
  id              String      @id
  kind            ProductKind
  title           String
  /// Curso de la biblioteca (contenedor de módulos), no un ítem de checkout.
  /// El acceso lo abre la membresía mensual — ver lib/lms/membership.ts.
  isCourseContent Boolean     @default(false) @map("is_course_content")
  imageUrl        String?     @map("image_url")
  sessionsLabel   String      @map("sessions_label")
  sessionsCount   Int?        @map("sessions_count")
  description     String?     @db.Text
  isActive        Boolean     @default(true) @map("is_active")
  sortOrder       Int         @default(0) @map("sort_order")
  unitPriceLabel  String?     @map("unit_price_label")
  tag             String?
  highlight       Boolean     @default(false)
  whatsappMessage String?     @map("whatsapp_message") @db.Text
  therapyHeadline String?     @map("therapy_headline")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  prices            ProductPrice[]
  enrollments       Enrollment[]
  workshopEditions  WorkshopEdition[]
  courseModules     CourseModule[]
  liveClassSessions LiveClassSession[]

  @@index([kind])
  @@map("products")
}

model ProductPrice {
  id              String   @id @default(cuid())
  productId       String   @map("product_id")
  currency        String   @db.Char(3)
  amountMinor     Int      @map("amount_minor")
  listAmountMinor Int?     @map("list_amount_minor")
  validFrom       DateTime @default(now()) @map("valid_from")
  createdAt       DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, currency])
  @@map("product_prices")
}

model WorkshopEdition {
  id                         String                @id @default(cuid())
  slug                       String                @unique
  productId                  String?               @map("product_id")
  title                      String
  editionLabel               String?               @map("edition_label")
  cardSummary                String?               @map("card_summary") @db.Text
  status                     WorkshopEditionStatus @default(DRAFT)
  startsAt                   DateTime?             @map("starts_at")
  endsAt                     DateTime?             @map("ends_at")
  timezone                   String                @default("America/Bogota")
  dateLabel                  String?               @map("date_label")
  scheduleLabel              String?               @map("schedule_label")
  capacity                   Int?
  whatsappTemplate           String?               @map("whatsapp_template") @db.Text
  heroLine1                  String?               @map("hero_line_1")
  heroLine2                  String?               @map("hero_line_2")
  heroLine3                  String?               @map("hero_line_3")
  detailSummary              String?               @map("detail_summary") @db.Text
  intro                      String?               @db.Text
  focusTopics                Json?                 @map("focus_topics")
  daySchedule                Json?                 @map("day_schedule")
  topicsSectionTitle         String?               @map("topics_section_title")
  topicsSectionDescription   String?               @map("topics_section_description") @db.Text
  scheduleSectionDescription String?               @map("schedule_section_description") @db.Text
  metaTitle                  String?               @map("meta_title")
  metaDescription            String?               @map("meta_description") @db.Text
  introOpen                  String?               @map("intro_open") @db.Text
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")

  product               Product?               @relation(fields: [productId], references: [id])
  enrollments           Enrollment[]
  notificationCampaigns NotificationCampaign[]
  documents             WorkshopDocument[]

  @@map("workshop_editions")
}

/// Singleton-style landing for the free webinar funnel (`/webinar-gratuito`).
/// One row per slug; seed creates `gratuito`. Toggle `isActive` to publish/unpublish.
/// `startsAt` is the real UTC instant; staff enter date/time in OPERATIONAL_TZ.
/// When `startsAtHasTime` is false, only the calendar date is shown publicly
/// (`startsAt` is stored as noon in OPERATIONAL_TZ as a date anchor).
model FreeWebinar {
  id                String    @id @default(cuid())
  slug              String    @unique @default("gratuito")
  isActive          Boolean   @default(false) @map("is_active")
  headline          String
  subheadline       String?   @db.Text
  body              String?   @db.Text
  startsAt          DateTime? @map("starts_at")
  startsAtHasTime   Boolean   @default(true) @map("starts_at_has_time")
  /// Enlace de la reunión (Google Meet). Al cambiarlo se reenvía por correo a
  /// todas las registradas: `updateFreeWebinar` limpia `linkEmailSentAt`.
  meetUrl           String?   @map("meet_url") @db.Text
  /// Legado: URL del blob privado de Vercel. El vídeo promocional se sirve por
  /// Mux (`muxPlaybackId`); se conserva la columna para no perder el objeto.
  videoUrl          String?   @map("video_url") @db.Text
  /// Vídeo promocional en Mux. A diferencia de las grabaciones del curso, la
  /// política de reproducción es `public` — es una landing de marketing.
  muxUploadId       String?         @map("mux_upload_id")
  muxAssetId        String?         @map("mux_asset_id")
  muxPlaybackId     String?         @map("mux_playback_id")
  videoStatus       RecordingStatus @default(NONE) @map("video_status")
  videoDurationSec  Int?            @map("video_duration_sec")
  videoErrorMessage String?         @map("video_error_message") @db.Text
  learnSectionTitle String?   @map("learn_section_title")
  learnItems        Json      @map("learn_items")
  faq               Json?
  ctaLabel          String    @default("Registrarme gratis") @map("cta_label")
  formTitle         String    @default("Reserva tu lugar") @map("form_title")
  metaTitle         String?   @map("meta_title")
  metaDescription   String?   @map("meta_description") @db.Text
  /// Sellada por el cron cuando la fecha ya pasó más el margen. Corta registros
  /// y recordatorios sin tocar nada destructivo. Null = edición todavía en pie.
  /// No toca `isActive`: ese interruptor es de Dayana y el cron no se lo pisa.
  endedAt           DateTime? @map("ended_at")
  /// La verdad sobre «cuál está viva» es el SLUG: la viva es siempre
  /// `gratuito`, y al archivar se renombra a `gratuito-<id>`. Esta columna es
  /// solo la fecha que se muestra en el historial — nunca un predicado.
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  registrations WebinarRegistration[]

  @@index([archivedAt])
  @@map("free_webinars")
}

/// Una fila por persona registrada al webinar. Los contactos ya llevan la
/// etiqueta `webinar-gratuito`; esta tabla existe para el estado de envío por
/// persona (enlace + recordatorios), que una ventana temporal no puede dar.
/// Cambiar `meetUrl` limpia `linkEmailSentAt`; cambiar `startsAt` limpia los
/// dos recordatorios — así una reprogramación no deja a nadie sin aviso.
model WebinarRegistration {
  id                String    @id @default(cuid())
  webinarId         String    @map("webinar_id")
  contactId         String    @map("contact_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  linkEmailSentAt   DateTime? @map("link_email_sent_at")
  reminder24hSentAt DateTime? @map("reminder_24h_sent_at")
  reminder1hSentAt  DateTime? @map("reminder_1h_sent_at")
  /// Último motivo de fallo, desnormalizado desde NotificationDelivery para
  /// poder filtrar «solo las fallidas» sin un join a 10k filas. El histórico
  /// completo de intentos (providerId, cuerpo, error) vive allí, no aquí.
  lastSendError     String?   @map("last_send_error") @db.Text
  lastSendErrorAt   DateTime? @map("last_send_error_at")

  webinar FreeWebinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([webinarId, contactId])
  @@map("webinar_registrations")
}

model WorkshopDocument {
  id                String   @id @default(cuid())
  workshopEditionId String   @map("workshop_edition_id")
  url               String   @db.Text
  filename          String
  mimeType          String   @map("mime_type")
  sizeBytes         Int      @map("size_bytes")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")

  workshopEdition WorkshopEdition @relation(fields: [workshopEditionId], references: [id], onDelete: Cascade)

  @@index([workshopEditionId])
  @@map("workshop_documents")
}

model Enrollment {
  id                 String           @id @default(cuid())
  contactId          String           @map("contact_id")
  productId          String           @map("product_id")
  workshopEditionId  String?          @map("workshop_edition_id")
  status             EnrollmentStatus @default(LEAD)
  label              String?
  isPrimary          Boolean          @default(false) @map("is_primary")
  parentEnrollmentId String?          @map("parent_enrollment_id")
  sessionsTotal      Int?             @map("sessions_total")
  sessionsUsed       Int              @default(0) @map("sessions_used")
  currency           String?          @db.Char(3)
  amountMinor        Int?             @map("amount_minor")
  externalRef        String?          @map("external_ref")
  paidUntil          DateTime?        @map("paid_until")
  leadAt             DateTime?        @map("lead_at")
  paidAt             DateTime?        @map("paid_at")
  completedAt        DateTime?        @map("completed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  contact                  Contact                   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  product                  Product                   @relation(fields: [productId], references: [id])
  workshopEdition          WorkshopEdition?          @relation(fields: [workshopEditionId], references: [id])
  parentEnrollment         Enrollment?               @relation("EnrollmentRenewals", fields: [parentEnrollmentId], references: [id])
  childEnrollments         Enrollment[]              @relation("EnrollmentRenewals")
  payments                 Payment[]
  therapyPackage           TherapyPackage?
  notebookPages            ContactNotebookPage[]
  paymentVerificationCodes PaymentVerificationCode[]
  promoCodeRedemption      PromoCodeRedemption?

  @@index([contactId, status])
  @@index([contactId, productId])
  @@index([status])
  @@index([updatedAt])
  @@index([paidUntil])
  @@map("enrollments")
}

model Payment {
  id                  String          @id @default(cuid())
  enrollmentId        String          @map("enrollment_id")
  provider            PaymentProvider
  providerPaymentId   String          @map("provider_payment_id")
  providerOrderId     String?         @map("provider_order_id")
  status              PaymentStatus
  currency            String          @db.Char(3)
  amountMinor         Int             @map("amount_minor")
  feeMinor            Int?            @map("fee_minor")
  netMinor            Int?            @map("net_minor")
  payerEmail          String?         @map("payer_email")
  payerCountryIso     String?         @map("payer_country_iso") @db.Char(2)
  rawPayload          Json?           @map("raw_payload")
  paidAt              DateTime?       @map("paid_at")
  membershipAppliedAt DateTime?       @map("membership_applied_at")
  /// Marca de que ya se envió el evento Purchase a Meta CAPI. `recordPayment`
  /// usa upsert y puede reemitir `payment/approved`, así que sin este sello el
  /// mismo pago se enviaría varias veces.
  capiSentAt          DateTime?       @map("capi_sent_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([enrollmentId])
  @@index([status, paidAt])
  @@map("payments")
}

// Gate before registering a manual payment: a 6-digit code is emailed to a
// fixed personal address (Dayana) and must be entered back to confirm.
model PaymentVerificationCode {
  id           String    @id @default(cuid())
  codeHash     String    @map("code_hash")
  email        String
  staffUserId  String    @map("staff_user_id")
  enrollmentId String?   @map("enrollment_id")
  attempts     Int       @default(0)
  usedAt       DateTime? @map("used_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  staffUser  StaffUser   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([staffUserId])
  @@map("payment_verification_codes")
}

enum PromoDiscountType {
  PERCENT
  FIXED_AMOUNT
}

// Applies at checkout, before payment. PERCENT works in both currencies as a
// ratio; FIXED_AMOUNT needs its own value per currency since 20 USD and 20
// COP are not comparable — a fixed code is only usable in a currency it has
// an amount configured for.
model PromoCode {
  id                String            @id @default(cuid())
  code              String            @unique
  description       String?
  discountType      PromoDiscountType @map("discount_type")
  percentOff        Int?              @map("percent_off")
  amountOffUsdMinor Int?              @map("amount_off_usd_minor")
  amountOffCopMinor Int?              @map("amount_off_cop_minor")
  isActive          Boolean           @default(true) @map("is_active")
  maxRedemptions    Int?              @map("max_redemptions")
  timesRedeemed     Int               @default(0) @map("times_redeemed")
  expiresAt         DateTime?         @map("expires_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  redemptions PromoCodeRedemption[]

  @@map("promo_codes")
}

model PromoCodeRedemption {
  id            String   @id @default(cuid())
  promoCodeId   String   @map("promo_code_id")
  enrollmentId  String   @unique @map("enrollment_id")
  currency      String   @db.Char(3)
  discountMinor Int      @map("discount_minor")
  createdAt     DateTime @default(now()) @map("created_at")

  promoCode  PromoCode  @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([promoCodeId])
  @@map("promo_code_redemptions")
}

model TherapyPackage {
  id                 String   @id @default(cuid())
  enrollmentId       String   @unique @map("enrollment_id")
  totalSessions      Int      @map("total_sessions")
  usedSessions       Int      @default(0) @map("used_sessions")
  meetDefaultUrl     String?  @map("meet_default_url")
  reprogrammingNotes String?  @map("reprogramming_notes") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  enrollment Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sessions   TherapySession[]

  @@map("therapy_packages")
}

model TherapySession {
  id               String               @id @default(cuid())
  therapyPackageId String               @map("therapy_package_id")
  sessionNumber    Int                  @map("session_number")
  scheduledAt      DateTime?            @map("scheduled_at")
  durationMinutes  Int                  @default(60) @map("duration_minutes")
  status           TherapySessionStatus @default(SCHEDULED)
  meetUrl          String?              @map("meet_url")
  /// Evento de Google Calendar que representa esta sesión, si se sincronizó.
  /// Guardarlo hace que volver a sincronizar actualice el evento en vez de
  /// crear uno nuevo cada vez.
  googleEventId    String?              @map("google_event_id")
  clinicalNotes    String?              @map("clinical_notes") @db.Text
  completedAt      DateTime?            @map("completed_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  therapyPackage TherapyPackage        @relation(fields: [therapyPackageId], references: [id], onDelete: Cascade)
  notebookPages  ContactNotebookPage[]

  @@unique([therapyPackageId, sessionNumber])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@map("therapy_sessions")
}

model ContactNotebookPage {
  id               String                 @id @default(cuid())
  contactId        String                 @map("contact_id")
  title            String
  sortOrder        Int                    @map("sort_order")
  kind             NotebookPageKind       @default(CANVAS)
  background       NotebookPageBackground @default(BLANK)
  canvasData       Json?                  @map("canvas_data")
  canvasUrl        String?                @map("canvas_url")
  bodyText         String?                @map("body_text") @db.Text
  attachmentUrl    String?                @map("attachment_url")
  attachmentMime   String?                @map("attachment_mime")
  attachmentName   String?                @map("attachment_name")
  previewUrl       String?                @map("preview_url")
  therapySessionId String?                @map("therapy_session_id")
  enrollmentId     String?                @map("enrollment_id")
  createdByStaffId String?                @map("created_by_staff_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  contact        Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  therapySession TherapySession? @relation(fields: [therapySessionId], references: [id], onDelete: SetNull)
  enrollment     Enrollment?     @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  createdByStaff StaffUser?      @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([contactId, sortOrder])
  @@index([contactId, updatedAt(sort: Desc)])
  @@map("contact_notebook_pages")
}

model StaffUser {

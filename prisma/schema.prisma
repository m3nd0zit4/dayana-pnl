  id          String   @id @default(cuid())
  contactId   String   @map("contact_id")
  moduleId    String   @map("module_id")
  completedAt DateTime @default(now()) @map("completed_at")

  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  module  CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([contactId, moduleId])
  @@index([moduleId])
  @@map("course_module_progress")
}

model LiveClassSession {
  id                    String            @id @default(cuid())
  productId             String            @map("product_id")
  moduleId              String?           @map("module_id")
  /// Clave estable del currículo versionado; null en las clases creadas a mano.
  slug                  String?
  title                 String
  description           String?           @db.Text
  scheduledAt           DateTime?         @map("scheduled_at")
  meetUrl               String?           @map("meet_url")
  recordingUrl          String?           @map("recording_url")
  recordingPostedAt     DateTime?         @map("recording_posted_at")
  recordingHiddenAt     DateTime?         @map("recording_hidden_at")
  muxUploadId           String?           @map("mux_upload_id")
  muxAssetId            String?           @map("mux_asset_id")
  muxPlaybackId         String?           @map("mux_playback_id")
  recordingStatus       RecordingStatus   @default(NONE) @map("recording_status")
  recordingDurationSec  Int?              @map("recording_duration_sec")
  recordingErrorMessage String?           @map("recording_error_message") @db.Text
  contentType           LessonContentType @default(VIDEO) @map("content_type")
  bodyMd                String?           @map("body_md") @db.Text
  materialUrl           String?           @map("material_url") @db.Text
  materialFileName      String?           @map("material_file_name")
  materialSizeBytes     Int?              @map("material_size_bytes")
  quizJson              Json?             @map("quiz_json")
  /// Campos del ejercicio interactivo — ver lib/lms/exercise.ts.
  exerciseJson          Json?             @map("exercise_json")
  /// Contenido permanente de la biblioteca: no caduca a los 30 días como la
  /// réplica de una clase en vivo (ver RECORDING_RETENTION_DAYS).
  evergreen             Boolean           @default(false)
  sortOrder             Int               @default(0) @map("sort_order")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  product  Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  module   CourseModule?         @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  progress CourseClassProgress[]
  comments LessonComment[]
  quizAttempts QuizAttempt[]
  exerciseResponses ExerciseResponse[]

  @@unique([productId, slug])
  @@index([productId, scheduledAt])
  @@index([moduleId, sortOrder])
  @@map("live_class_sessions")
}

model CourseClassProgress {
  id          String   @id @default(cuid())
  contactId   String   @map("contact_id")
  classId     String   @map("class_id")
  completedAt DateTime @default(now()) @map("completed_at")

  contact Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  class   LiveClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([contactId, classId])
  @@index([classId])
  @@map("course_class_progress")
}

/// Lo que un alumno ha escrito en un ejercicio.
///
/// Una fila por persona y ejercicio, sobrescrita en cada autoguardado: el
/// cuaderno del curso, no un historial de versiones. `answers` es un mapa
/// `campoId → texto`, así que añadir o quitar un campo del ejercicio no invalida
/// lo ya escrito.
model ExerciseResponse {
  id          String   @id @default(cuid())
  classId     String   @map("class_id")
  contactId   String   @map("contact_id")
  answers     Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  class   LiveClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  contact Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, classId])
  @@index([classId])
  @@map("exercise_responses")
}

/// Un intento de cuestionario.
///
/// La fila se crea al **empezar**, no al enviar: el límite de tiempo se mide
/// contra `startedAt` en el servidor, que es el único reloj en el que se puede
/// confiar. Un intento sin `submittedAt` está en curso; al reanudar la página
/// se recupera y el contador sigue donde iba.
model QuizAttempt {
  id          String    @id @default(cuid())
  classId     String    @map("class_id")
  contactId   String    @map("contact_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  submittedAt DateTime? @map("submitted_at")
  /// Respuestas enviadas, para que el alumno pueda revisar el intento después.
  answers     Json?
  score       Int?
  total       Int?
  passed      Boolean?

  class   LiveClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  contact Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([classId, contactId])
  @@map("quiz_attempts")
}

model LessonComment {
  id        String    @id @default(cuid())
  classId   String    @map("class_id")
  contactId String    @map("contact_id")
  body      String    @db.Text
  hiddenAt  DateTime? @map("hidden_at")
  createdAt DateTime  @default(now()) @map("created_at")

  class   LiveClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  contact Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([classId, createdAt])
  // No había ningún índice por contactId: la cascada al borrar un contacto
  // escaneaba la tabla de comentarios entera.
  @@index([contactId])
  @@map("lesson_comments")
}

/// Perfil resuelto por el cuestionario público de `/diagnostico`.
///
/// Son tres y no cinco a propósito: el perfil elige **qué se le recomienda**,
/// no qué paquete existe. Cinco perfiles reproducirían dentro del resultado la
/// misma parálisis de elección que el catálogo de `/servicios` provoca fuera.
enum DiagnosticProfile {
  EXPLORADOR
  EN_PROCESO
  RAIZ_PROFUNDA
}

/// Una sesión del cuestionario público. Es la llamada de ventas codificada:
/// la persona nombra su dolor, se le devuelve un perfil y **una** oferta.
///
/// La fila nace **anónima** en el primer paso y se parchea paso a paso. Eso
/// da dos cosas que un único POST al final no daría: se puede retomar el
/// cuestionario, y el abandono es medible por pregunta en vez de ser un
/// agujero negro. `contactId` sólo se adjunta en el paso final, cuando la
/// persona entrega sus datos.
model Diagnostic {
  id String @id @default(cuid())

  /// Segmento público de la URL del resultado. **No es una frontera de
  /// confianza** — igual que `?ref=` en `/pago/exito`, sólo lee una fila que
  /// ya existe. Pero la fila lleva datos personales, así que el token se
  /// genera con 32 bytes de aleatoriedad real, no con un cuid secuenciable.
  token String @unique

  contactId String? @map("contact_id")

  /// `{ [questionId]: string | string[] }`. Json y no columnas porque el
  /// cuestionario es copy editable: añadir una pregunta no debe ser una
  /// migración. La forma la valida `lib/diagnostico/questions.ts`.
  answers Json @default("{}")

  profile      DiagnosticProfile?
  urgencyScore Int?               @map("urgency_score")

  /// 0–10. Cuán cerca está de decidirse: qué la ha frenado, por qué eligió a
  /// Dayana y si puede invertir hoy. Es lo que ordena la bandeja del panel —
  /// la respuesta a "¿a quién llamo primero?" — y por eso es columna y no un
  /// cálculo sobre `answers`: se ordena en SQL, no en memoria.
  commitmentScore Int? @map("commitment_score")

  /// Producto recomendado en el momento de completar. Se guarda para poder
  /// medir qué se recomendó frente a qué se compró; la página de resultado lo
  /// vuelve a resolver en cada carga, porque el producto puede haberse
  /// desactivado o quedarse sin precio en la moneda de la región.
  recommendedProductId String? @map("recommended_product_id")

  /// De dónde llegó: enlaces | home | servicios | webinar | ad.
  source String?

  completedAt       DateTime? @map("completed_at")
  viewedResultAt    DateTime? @map("viewed_result_at")
  checkoutStartedAt DateTime? @map("checkout_started_at")

  /// Cuándo se mandó el `Lead` a la Conversions API. Mismo papel que
  /// `Payment.capiSentAt`: el evento `diagnostic/completed` se reintenta
  /// —Inngest reintenta y `/api/leads` es reenviable— y un Lead contado dos
  /// veces infla el coste por lead de todas las campañas.
  capiSentAt DateTime? @map("capi_sent_at")

  /// Cuándo se avisó al equipo de que este diagnóstico se quedó sin compra.
  /// Se reclama ANTES de avisar (`updateMany` con `IS NULL`), así que un cron
  /// repetido o dos despliegues a la vez no avisan dos veces de la misma
  /// persona.
  followUpNotifiedAt DateTime? @map("follow_up_notified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// `SetNull` en ambos lados: borrar un contacto o retirar un producto no
  /// puede llevarse por delante la analítica del embudo.
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [recommendedProductId], references: [id], onDelete: SetNull)

  @@index([contactId])
  /// El panel lista por "completados, lo más reciente primero" y descarta los
  /// abandonados; sin el orden en el índice eso es un sort en memoria.
  @@index([completedAt(sort: Desc)])
  @@map("diagnostics")
}

/// Un enlace de pago que el equipo genera y envía por WhatsApp.
///
/// Existe porque el camino real de venta hoy termina en una conversación: se
/// habla con la persona, se acuerda un paquete concreto y hay que cobrarlo.
/// Hasta ahora eso significaba mandarla al catálogo entero a que encontrara
/// sola lo que ya habían acordado — cinco precios y una tabla comparativa
/// delante de alguien que ya había decidido. Cada opción de más es una
/// oportunidad de reconsiderar.
///
/// El enlace abre una página con **un solo producto**, su precio, y un botón.
/// Nada más: ni menú, ni comparativa, ni las otras opciones.
model PaymentLink {
  id String @id @default(cuid())

  /// Segmento público de la URL. 32 bytes de aleatoriedad real, igual que
  /// `Diagnostic.token`, porque la página muestra el nombre de la persona.
  /// **No decide qué se cobra**: el precio sale del producto en cada carga,
  /// nunca del enlace, así que manipularlo no puede cambiar un importe.
  token String @unique

  contactId String @map("contact_id")
  productId String @map("product_id")

  /// Nota corta que se pinta bajo el precio: "lo que hablamos el martes".
  /// La escribe quien genera el enlace y es lo que lo hace personal.
  note String? @db.Text

  /// Quién lo generó, para la auditoría.
  createdByStaffId String? @map("created_by_staff_id")

  /// Vencimiento opcional. Un enlace acordado en una llamada no debería seguir
  /// vivo meses después, cuando el precio ya cambió.
  expiresAt DateTime? @map("expires_at")

  /// Se sella al abrirlo y al empezar el pago. Sirve para saber si la persona
  /// llegó a verlo antes de insistirle.
  openedAt          DateTime? @map("opened_at")
  checkoutStartedAt DateTime? @map("checkout_started_at")

  /// Se desactiva a mano desde el panel. Un enlace revocado responde 404.
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contact        Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdByStaff StaffUser?  @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt(sort: Desc)])
  @@map("payment_links")
}

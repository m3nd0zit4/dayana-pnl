generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // pg_trgm sostiene el índice GIN de Contact.searchText — sin él la búsqueda
  // de contactos es un seq scan por pulsación de tecla.
  extensions = [pg_trgm]
}

enum ContactSource {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  WEB
  WEB_LEAD_FORM
  WHATSAPP_DIRECT
  REFERRAL
  OTHER
}

enum ProductKind {
  THERAPY
  COURSE
  WORKSHOP
}

enum EnrollmentStatus {
  LEAD
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  PAYPAL
  MERCADO_PAGO
  MANUAL
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
  REFUNDED
}

enum TherapySessionStatus {
  PENDING_SCHEDULE
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

enum NotebookPageKind {
  CANVAS
  UPLOAD
}

enum NotebookPageBackground {
  BLANK
  RULED
  GRID
}

enum WorkshopEditionStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
}

enum StaffRole {
  OWNER
  OPERATOR
  READONLY
  DEVELOPER
}

enum MemberAuthTokenPurpose {
  INVITE
  PASSWORD_RESET
}

enum MessageChannel {
  WHATSAPP_LINK
  WHATSAPP_API
  EMAIL
  SMS
  INTERNAL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationCampaignStatus {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

/// Canal de Meta de un hilo de la bandeja de entrada.
enum ConversationChannel {
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

enum ConversationStatus {
  OPEN
  /// Respondimos y esperamos al cliente.
  PENDING
  CLOSED
}

/// Servicio de Google que una cuenta conectada expone al agente.
///
/// Cada servicio añade sus propios scopes al consentimiento, así que activar
/// uno nuevo sobre una cuenta ya conectada obliga a volver a autorizarla.
enum GoogleService {
  CALENDAR
  CONTACTS
  DRIVE
}

/// Red social conectada para publicar contenido.
enum SocialProvider {
  TIKTOK
  INSTAGRAM
  FACEBOOK
}

enum SocialMediaType {
  VIDEO
  PHOTO
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  /// Reclamado por el worker; impide que dos ejecuciones publiquen lo mismo.
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

enum RecordingStatus {
  NONE
  UPLOADING
  PROCESSING
  READY
  ERRORED
}

/// Qué tipo de contenido es este item dentro del módulo — antes solo existían
/// clases de video; ahora un módulo puede mezclar video, lectura, material
/// descargable y cuestionarios.
enum LessonContentType {
  VIDEO
  TEXT
  PDF
  QUIZ
  /// Ejercicio con campos que el alumno responde dentro del portal; las
  /// respuestas se guardan en `ExerciseResponse`.
  EXERCISE
}

/// Catálogo de eventos de la plataforma. La etiqueta, la descripción y los
/// valores por defecto viven en lib/notifications/platform/catalog.ts — este
/// enum solo garantiza integridad referencial.
/// Estado de una suscripción recurrente, tal como lo reporta el proveedor.
enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum NotificationEventType {
  // Pagos y ventas
  PAYMENT_APPROVED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  MANUAL_PAYMENT_RECORDED
  PAYMENT_WEBHOOK_FAILED
  PAYMENT_CONTACT_INCOMPLETE
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_PAYMENT_FAILED
  SUBSCRIPTION_CANCELLED
  PRICE_SYNC_DRIFT
  SUBSCRIPTION_AMOUNT_MISMATCH
  SUBSCRIPTION_PRICE_PROPAGATION_FAILED
  // Embudo e inscripciones
  LEAD_CREATED
  WEB_LEAD_SUBMITTED
  ENROLLMENT_PENDING_PAYMENT
  ENROLLMENT_ACTIVATED
  ENROLLMENT_STATUS_CHANGED
  CHECKOUT_ABANDONED
  LEAD_STALE
  DIAGNOSTIC_COMPLETED
  DIAGNOSTIC_UNCONVERTED
  // Terapias
  THERAPY_SESSION_SCHEDULED
  THERAPY_SESSION_RESCHEDULED
  THERAPY_SESSION_COMPLETED
  THERAPY_SESSION_NO_SHOW
  // Curso y membresía
  MEMBER_SIGNED_UP
  MEMBERSHIP_DUE_SOON
  MEMBERSHIP_OVERDUE
  MEMBERSHIP_EXTENDED
  COURSE_ACCESS_GRANTED
  LESSON_COMMENT_POSTED
  CLASS_RECORDING_PUBLISHED
  // Sistema, seguridad y comunicación
  LOGIN_FAILED
  LOGIN_SUCCEEDED
  STAFF_USER_CREATED
  AGENT_ACTION_EXECUTED
  CAMPAIGN_COMPLETED
  NOTIFICATION_DELIVERY_FAILED
  SYSTEM_ALERT
  // Bandeja de entrada
  INBOX_MESSAGE_RECEIVED
  // Publicación en redes
  SOCIAL_POST_PUBLISHED
  SOCIAL_POST_FAILED
}

model Contact {
  id                  String        @id @default(cuid())
  phoneE164           String        @unique @map("phone_e164")
  phoneCountryIso     String?       @map("phone_country_iso") @db.Char(2)
  email               String?       @unique
  firstName           String        @map("first_name")
  lastName            String?       @map("last_name")
  displayName         String?       @map("display_name")
  countryIso          String?       @map("country_iso") @db.Char(2)
  timezone            String        @default("America/Bogota")
  preferredLocale     String        @default("es") @map("preferred_locale")
  avatarUrl           String?       @map("avatar_url")
  workDescription     String?       @map("work_description")
  themePreference     String        @default("system") @map("theme_preference")
  notifyEmail         Boolean       @default(true) @map("notify_email")
  notifySms           Boolean       @default(true) @map("notify_sms")
  notifyWhatsapp      Boolean       @default(true) @map("notify_whatsapp")
  notifyInApp         Boolean       @default(true) @map("notify_in_app")
  source              ContactSource @default(WEB)
  sourceDetail        String?       @map("source_detail")
  tiktokHandle        String?       @map("tiktok_handle")
  notes               String?       @db.Text
  consentDataAt       DateTime?     @map("consent_data_at")
  consentMarketingAt  DateTime?     @map("consent_marketing_at")
  /// Consentimiento para medición publicitaria (Meta CAPI, Google Ads).
  /// Deliberadamente separado de `consentMarketingAt`: aceptar recibir
  /// comunicaciones comerciales no es aceptar que se envíen datos a
  /// plataformas de anuncios. Sin esta fecha, CAPI no envía nada de este
  /// contacto — el envío desde servidor recupera señal que el navegador
  /// bloquea por motivos técnicos, no consentimiento que el usuario negó.
  consentAdTrackingAt DateTime?     @map("consent_ad_tracking_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  enrollments            Enrollment[]
  tags                   ContactTag[]
  messageLogs            MessageLog[]
  notificationDeliveries NotificationDelivery[]
  notificationRecipients NotificationRecipient[]
  notebookPages          ContactNotebookPage[]
  memberAccount          MemberAccount?
  memberAuthTokens       MemberAuthToken[]
  moduleProgress         CourseModuleProgress[]
  classProgress          CourseClassProgress[]
  lessonComments         LessonComment[]
  quizAttempts           QuizAttempt[]
  exerciseResponses      ExerciseResponse[]
  conversations          Conversation[]
  channelIdentities      ContactChannelIdentity[]
  webinarRegistrations   WebinarRegistration[]
  diagnostics            Diagnostic[]
  paymentLinks           PaymentLink[]

  /// Columna de búsqueda plegada: nombre, apellido, display, email y teléfono
  /// (con y sin separadores) en minúsculas y sin tildes.
  ///
  /// La mantiene un trigger BEFORE INSERT/UPDATE — **nunca la escribas desde
  /// Prisma**: lo que pongas se sobrescribe. Es un trigger y no una columna
  /// `GENERATED ALWAYS` porque Prisma no puede declarar esa segunda forma, y
  /// su differ emitiría un `DROP DEFAULT` contra ella en cada `migrate dev`.
  /// La expresión vive en
  /// `prisma/migrations/20260816120000_contact_search/migration.sql` y su
  /// gemela en JS es `foldForSearch()` en `lib/crm/search-normalize.ts`:
  /// si cambias una, cambia la otra o la búsqueda devolverá cero en silencio.
  ///
  /// Existe porque buscar con seis `ILIKE '%x%'` sobre columnas sueltas no
  /// puede usar ningún índice: el comodín a la izquierda lo impide. Una sola
  /// columna con un GIN de trigramas colapsa los seis predicados en uno.
  ///
  /// `notes` queda fuera a propósito — es @db.Text sin cota y se reescribe a
  /// menudo, así que mantener sus trigramas sería el coste dominante. La
  /// búsqueda en notas es un camino aparte y opt-in (ContactSearchFilters).
  searchText String? @map("search_text")

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([countryIso])
  @@index([consentMarketingAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("contacts")
}

model Product {
  id              String      @id
  kind            ProductKind
  title           String
  /// Curso de la biblioteca (contenedor de módulos), no un ítem de checkout.
  /// El acceso lo abre la membresía mensual — ver lib/lms/membership.ts.
  isCourseContent Boolean     @default(false) @map("is_course_content")
  /// El curso de la biblioteca se vende TAMBIÉN suelto, no sólo vía
  /// mensualidad. Sin esto un curso sigue siendo invisible para el catálogo
  /// público (`getActiveProducts`) y para el checkout (`getPlanFromDb`).
  ///
  /// Explícito y no derivado de «tiene precio»: una fila ProductPrice puede
  /// existir para el CRM —o para preparar un lanzamiento— sin querer que el
  /// botón de comprar aparezca todavía en la web.
  ///
  /// Sólo tiene sentido con `isCourseContent`. La mensualidad ya se vende por
  /// su propia vía y poner esto a true en ella no cambia nada.
  sellsStandalone Boolean     @default(false) @map("sells_standalone")
  imageUrl        String?     @map("image_url")
  sessionsLabel   String      @map("sessions_label")
  sessionsCount   Int?        @map("sessions_count")
  description     String?     @db.Text
  isActive        Boolean     @default(true) @map("is_active")
  sortOrder       Int         @default(0) @map("sort_order")
  unitPriceLabel  String?     @map("unit_price_label")
  tag             String?
  highlight       Boolean     @default(false)
  whatsappMessage String?     @map("whatsapp_message") @db.Text
  therapyHeadline String?     @map("therapy_headline")

  /// Espejo del Product de PayPal, escrito por scripts/paypal/setup-subscription.ts.
  paypalProductId String? @unique @map("paypal_product_id")
  /// Billing Plan mensual de PayPal. Lleva el gross-up de comisión YA aplicado
  /// (lib/pricing/fees.ts): los planes cobran un importe fijo, no uno calculado
  /// por petición como hacen create-order y Mercado Pago. Cambiar
  /// PAYPAL_FEE_PERCENT obliga a re-ejecutar el script y crear un plan nuevo,
  /// porque PayPal no deja borrar planes, sólo desactivarlos. Vive aquí y NO en
  /// ProductPrice, que es el histórico de precios PÚBLICOS y cuya fila más
  /// reciente se muestra en la web: escribir ahí el importe con comisión
  /// inflaría el precio de cara a la clienta.
  /// Cuántos meses de acceso concede un pago aprobado de este producto.
  /// Sólo lo leen los productos COURSE que no son contenido: 1 la mensualidad,
  /// 12 la anualidad. Vive en el producto y no en una constante porque es lo
  /// que distingue los dos planes de membresía, y `applyMembershipExtension`
  /// tiene que poder decidirlo sin conocer ids concretos.
  membershipMonths Int? @map("membership_months")

  paypalPlanId    String? @unique @map("paypal_plan_id")

  /// Plan de suscripción (preapproval_plan) de Mercado Pago, en COP. Mismo
  /// criterio que `paypalPlanId`: el importe lleva el gross-up ya aplicado
  /// porque el plan cobra una cifra fija. OJO — el cobro recurrente de MP sólo
  /// funciona con TARJETA: ni PSE, ni Nequi, ni efectivo. Por eso en Colombia
  /// conviven la suscripción y el pago suelto.
  mercadoPagoPreapprovalPlanId String? @unique @map("mercadopago_preapproval_plan_id")

  /// ¿Cuadra el precio del CRM con lo que cobran los planes del proveedor?
  ///
  /// `DRIFTED` sólo se alcanza cuando algo salió mal de verdad: una
  /// actualización a medias que no se pudo revertir, o el cron encontrando una
  /// diferencia. Mientras esté así, `changeSubscriptionPrice` rehúsa nuevos
  /// cambios — apilar un desfase sobre otro deja imposible saber qué se cobra.
  priceSyncStatus    SubscriptionPriceSyncStatus @default(SYNCED) @map("price_sync_status")
  /// Qué cobra cada lado, en texto, para que el panel lo pueda enseñar sin
  /// tener que volver a llamar a los proveedores.
  priceSyncNote      String?   @map("price_sync_note") @db.Text
  priceSyncCheckedAt DateTime? @map("price_sync_checked_at")

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  prices            ProductPrice[]
  priceSyncs        ProductPriceSync[]
  enrollments       Enrollment[]
  workshopEditions  WorkshopEdition[]
  courseModules     CourseModule[]
  liveClassSessions LiveClassSession[]
  promoCodes        PromoCodeProduct[]
  diagnostics       Diagnostic[]
  paymentLinks      PaymentLink[]

  @@index([kind])
  @@map("products")
}

model ProductPrice {
  id              String   @id @default(cuid())
  productId       String   @map("product_id")
  currency        String   @db.Char(3)
  amountMinor     Int      @map("amount_minor")
  listAmountMinor Int?     @map("list_amount_minor")
  validFrom       DateTime @default(now()) @map("valid_from")
  createdAt       DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, currency])
  @@map("product_prices")
}

enum SubscriptionPriceSyncStatus {
  SYNCED
  DRIFTED
}

/// Lo que un proveedor confirmó que va a cobrar por la mensualidad.
///
/// Es el testigo del invariante: una fila aquí significa que PayPal o Mercado
/// Pago ACEPTARON el importe. `ProductPrice` sólo se escribe cuando existen
/// estas filas, así que la web no puede anunciar un precio que los planes no
/// estén cobrando ya.
///
/// Guarda el bruto (con gross-up, que es lo que cobra el plan) junto al neto
/// del que salió, porque son cifras distintas y comparar la equivocada es
/// justo el error que esta tabla existe para evitar. El histórico importa: un
/// cobro puede llegar con el precio ANTERIOR y seguir siendo correcto, porque
/// PayPal no aplica un cambio a los pagos de los 10 días siguientes.
model ProductPriceSync {
  id             String          @id @default(cuid())
  productId      String          @map("product_id")
  provider       PaymentProvider
  currency       String          @db.Char(3)
  grossMinor     Int             @map("gross_minor")
  netMinor       Int             @map("net_minor")
  externalPlanId String          @map("external_plan_id")
  appliedAt      DateTime        @default(now()) @map("applied_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, provider, appliedAt(sort: Desc)])
  @@map("product_price_syncs")
}

model WorkshopEdition {
  id                         String                @id @default(cuid())
  slug                       String                @unique
  productId                  String?               @map("product_id")
  title                      String
  editionLabel               String?               @map("edition_label")
  cardSummary                String?               @map("card_summary") @db.Text
  status                     WorkshopEditionStatus @default(DRAFT)
  startsAt                   DateTime?             @map("starts_at")
  endsAt                     DateTime?             @map("ends_at")
  timezone                   String                @default("America/Bogota")
  dateLabel                  String?               @map("date_label")
  scheduleLabel              String?               @map("schedule_label")
  capacity                   Int?
  whatsappTemplate           String?               @map("whatsapp_template") @db.Text
  heroLine1                  String?               @map("hero_line_1")
  heroLine2                  String?               @map("hero_line_2")
  heroLine3                  String?               @map("hero_line_3")
  detailSummary              String?               @map("detail_summary") @db.Text
  intro                      String?               @db.Text
  focusTopics                Json?                 @map("focus_topics")
  daySchedule                Json?                 @map("day_schedule")
  topicsSectionTitle         String?               @map("topics_section_title")
  topicsSectionDescription   String?               @map("topics_section_description") @db.Text
  scheduleSectionDescription String?               @map("schedule_section_description") @db.Text
  metaTitle                  String?               @map("meta_title")
  metaDescription            String?               @map("meta_description") @db.Text
  introOpen                  String?               @map("intro_open") @db.Text
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")

  product               Product?               @relation(fields: [productId], references: [id])
  enrollments           Enrollment[]
  notificationCampaigns NotificationCampaign[]
  documents             WorkshopDocument[]

  @@map("workshop_editions")
}

/// Singleton-style landing for the free webinar funnel (`/webinar-gratuito`).
/// One row per slug; seed creates `gratuito`. Toggle `isActive` to publish/unpublish.
/// `startsAt` is the real UTC instant; staff enter date/time in OPERATIONAL_TZ.
/// When `startsAtHasTime` is false, only the calendar date is shown publicly
/// (`startsAt` is stored as noon in OPERATIONAL_TZ as a date anchor).
model FreeWebinar {
  id                String    @id @default(cuid())
  slug              String    @unique @default("gratuito")
  isActive          Boolean   @default(false) @map("is_active")
  headline          String
  subheadline       String?   @db.Text
  body              String?   @db.Text
  startsAt          DateTime? @map("starts_at")
  startsAtHasTime   Boolean   @default(true) @map("starts_at_has_time")
  /// Enlace de la reunión (Google Meet). Al cambiarlo se reenvía por correo a
  /// todas las registradas: `updateFreeWebinar` limpia `linkEmailSentAt`.
  meetUrl           String?   @map("meet_url") @db.Text
  /// Legado: URL del blob privado de Vercel. El vídeo promocional se sirve por
  /// Mux (`muxPlaybackId`); se conserva la columna para no perder el objeto.
  videoUrl          String?   @map("video_url") @db.Text
  /// Vídeo promocional en Mux. A diferencia de las grabaciones del curso, la
  /// política de reproducción es `public` — es una landing de marketing.
  muxUploadId       String?         @map("mux_upload_id")
  muxAssetId        String?         @map("mux_asset_id")
  muxPlaybackId     String?         @map("mux_playback_id")
  videoStatus       RecordingStatus @default(NONE) @map("video_status")
  videoDurationSec  Int?            @map("video_duration_sec")
  videoErrorMessage String?         @map("video_error_message") @db.Text
  learnSectionTitle String?   @map("learn_section_title")
  learnItems        Json      @map("learn_items")
  faq               Json?
  ctaLabel          String    @default("Registrarme gratis") @map("cta_label")
  formTitle         String    @default("Reserva tu lugar") @map("form_title")
  metaTitle         String?   @map("meta_title")
  metaDescription   String?   @map("meta_description") @db.Text
  /// Cupo previsto de la sala. Es informativo, NO un tope: pasado el número
  /// la gente se sigue pudiendo registrar y sigue recibiendo el enlace. Sirve
  /// para fijar la expectativa en la landing y para que el CRM avise cuando se
  /// supera, no para cerrar el formulario.
  capacity          Int?      @default(100)
  /// Material descargable opcional (una guía, un PDF de apoyo). Vive en el
  /// blob privado y se sirve por `/api/webinar/material`; nunca se expone la
  /// URL del blob. Opcional a propósito: no bloquea la publicación.
  materialUrl       String?   @map("material_url") @db.Text
  materialFileName  String?   @map("material_file_name")
  materialMimeType  String?   @map("material_mime_type")
  materialSizeBytes Int?      @map("material_size_bytes")
  /// Sellada por el cron cuando la fecha ya pasó más el margen. Corta registros
  /// y recordatorios sin tocar nada destructivo. Null = edición todavía en pie.
  /// No toca `isActive`: ese interruptor es de Dayana y el cron no se lo pisa.
  endedAt           DateTime? @map("ended_at")
  /// La verdad sobre «cuál está viva» es el SLUG: la viva es siempre
  /// `gratuito`, y al archivar se renombra a `gratuito-<id>`. Esta columna es
  /// solo la fecha que se muestra en el historial — nunca un predicado.
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  registrations WebinarRegistration[]

  @@index([archivedAt])
  @@map("free_webinars")
}

/// Una fila por persona registrada al webinar. Los contactos ya llevan la
/// etiqueta `webinar-gratuito`; esta tabla existe para el estado de envío por
/// persona (enlace + recordatorios), que una ventana temporal no puede dar.
/// Cambiar `meetUrl` limpia `linkEmailSentAt`; cambiar `startsAt` limpia los
/// dos recordatorios — así una reprogramación no deja a nadie sin aviso.
model WebinarRegistration {
  id                String    @id @default(cuid())
  webinarId         String    @map("webinar_id")
  contactId         String    @map("contact_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  linkEmailSentAt   DateTime? @map("link_email_sent_at")
  reminder24hSentAt DateTime? @map("reminder_24h_sent_at")
  reminder1hSentAt  DateTime? @map("reminder_1h_sent_at")
  /// Último motivo de fallo, desnormalizado desde NotificationDelivery para
  /// poder filtrar «solo las fallidas» sin un join a 10k filas. El histórico
  /// completo de intentos (providerId, cuerpo, error) vive allí, no aquí.
  lastSendError     String?   @map("last_send_error") @db.Text
  lastSendErrorAt   DateTime? @map("last_send_error_at")

  webinar FreeWebinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([webinarId, contactId])
  // El panel de registradas hace WHERE webinar_id = ? ORDER BY created_at DESC
  // y hasta ahora no tenía ningún índice que lo sostuviera.
  @@index([webinarId, createdAt(sort: Desc)])
  @@map("webinar_registrations")
}

model WorkshopDocument {
  id                String   @id @default(cuid())
  workshopEditionId String   @map("workshop_edition_id")
  url               String   @db.Text
  filename          String
  mimeType          String   @map("mime_type")
  sizeBytes         Int      @map("size_bytes")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")

  workshopEdition WorkshopEdition @relation(fields: [workshopEditionId], references: [id], onDelete: Cascade)

  @@index([workshopEditionId])
  @@map("workshop_documents")
}

model Enrollment {
  id                 String           @id @default(cuid())
  contactId          String           @map("contact_id")
  productId          String           @map("product_id")
  workshopEditionId  String?          @map("workshop_edition_id")
  status             EnrollmentStatus @default(LEAD)
  label              String?
  isPrimary          Boolean          @default(false) @map("is_primary")
  parentEnrollmentId String?          @map("parent_enrollment_id")
  sessionsTotal      Int?             @map("sessions_total")
  sessionsUsed       Int              @default(0) @map("sessions_used")
  currency           String?          @db.Char(3)
  amountMinor        Int?             @map("amount_minor")
  externalRef        String?          @map("external_ref")
  paidUntil          DateTime?        @map("paid_until")
  /// Compra suelta de un curso de la biblioteca: el acceso no caduca.
  ///
  /// Es un booleano y no un `paidUntil` lejano porque «no caduca» y «caduca en
  /// el año 3000» no son lo mismo para el resto del código: los avisos de
  /// renovación, el cron de morosidad y `MEMBERSHIP_WARNING_DAYS` leen
  /// `paidUntil` y todos tendrían que aprender a ignorar una fecha centinela.
  ///
  /// OJO — con esto en true, `paidUntil == null` NO significa «nunca pagó».
  /// Ver `membershipInfoFrom` en lib/lms/membership.ts.
  lifetimeAccess     Boolean          @default(false) @map("lifetime_access")
  /// Suscripción de PayPal que renueva esta matrícula. Es la clave por la que
  /// se resuelve cada cobro recurrente: `PAYMENT.SALE.COMPLETED` trae
  /// `billing_agreement_id` y NO garantiza propagar el `custom_id`.
  paypalSubscriptionId String?             @unique @map("paypal_subscription_id")
  /// Último estado reportado por PayPal. Es informativo para el portal: el
  /// acceso lo decide `paidUntil`, no esto — cancelar detiene la renovación,
  /// no el mes ya pagado.
  subscriptionStatus   SubscriptionStatus? @map("subscription_status")
  /// Suscripción de Mercado Pago (preapproval) que renueva esta matrícula.
  mercadoPagoPreapprovalId String?         @unique @map("mercadopago_preapproval_id")
  /// Quién cobra la renovación. Lo necesita el portal para saber a qué API
  /// pedir la cancelación.
  subscriptionProvider PaymentProvider?    @map("subscription_provider")
  leadAt             DateTime?        @map("lead_at")
  paidAt             DateTime?        @map("paid_at")
  completedAt        DateTime?        @map("completed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  contact                  Contact                   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  product                  Product                   @relation(fields: [productId], references: [id])
  workshopEdition          WorkshopEdition?          @relation(fields: [workshopEditionId], references: [id])
  parentEnrollment         Enrollment?               @relation("EnrollmentRenewals", fields: [parentEnrollmentId], references: [id])
  childEnrollments         Enrollment[]              @relation("EnrollmentRenewals")
  payments                 Payment[]
  therapyPackage           TherapyPackage?
  notebookPages            ContactNotebookPage[]
  paymentVerificationCodes PaymentVerificationCode[]
  promoCodeRedemption      PromoCodeRedemption?

  @@index([contactId, status])
  @@index([contactId, productId])
  @@index([status])
  // therapies-list.ts filtra por status y ordena por updatedAt; el índice
  // suelto de updatedAt no puede filtrar primero.
  @@index([status, updatedAt(sort: Desc)])
  @@index([updatedAt])
  @@index([paidUntil])
  @@map("enrollments")
}

model Payment {
  id                  String          @id @default(cuid())
  enrollmentId        String          @map("enrollment_id")
  provider            PaymentProvider
  providerPaymentId   String          @map("provider_payment_id")
  providerOrderId     String?         @map("provider_order_id")
  status              PaymentStatus
  currency            String          @db.Char(3)
  amountMinor         Int             @map("amount_minor")
  feeMinor            Int?            @map("fee_minor")
  netMinor            Int?            @map("net_minor")
  payerEmail          String?         @map("payer_email")
  payerCountryIso     String?         @map("payer_country_iso") @db.Char(2)
  /// Por qué falló, en el código del proveedor: `INSTRUMENT_DECLINED` de
  /// PayPal, `cc_rejected_insufficient_amount` de Mercado Pago. Se guarda el
  /// crudo y no el traducido porque el texto puede cambiar y este dato tiene
  /// que seguir sirviendo para reclamar al proveedor meses después.
  failureCode         String?         @map("failure_code")
  /// El motivo ya traducido, tal como se le explica al equipo — incluye el
  /// `debug_id` de PayPal cuando lo hay, que es lo único con lo que su soporte
  /// puede localizar la operación.
  failureMessage      String?         @map("failure_message") @db.Text
  rawPayload          Json?           @map("raw_payload")
  paidAt              DateTime?       @map("paid_at")
  membershipAppliedAt DateTime?       @map("membership_applied_at")
  /// Marca de que ya se envió el evento Purchase a Meta CAPI. `recordPayment`
  /// usa upsert y puede reemitir `payment/approved`, así que sin este sello el
  /// mismo pago se enviaría varias veces.
  capiSentAt          DateTime?       @map("capi_sent_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([enrollmentId])
  @@index([status, paidAt])
  @@map("payments")
}

// Gate before registering a manual payment: a 6-digit code is emailed to a
// fixed personal address (Dayana) and must be entered back to confirm.
model PaymentVerificationCode {
  id           String    @id @default(cuid())
  codeHash     String    @map("code_hash")
  email        String
  staffUserId  String    @map("staff_user_id")
  enrollmentId String?   @map("enrollment_id")
  attempts     Int       @default(0)
  usedAt       DateTime? @map("used_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  staffUser  StaffUser   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([staffUserId])
  @@map("payment_verification_codes")
}

enum PromoDiscountType {
  PERCENT
  FIXED_AMOUNT
}

// Applies at checkout, before payment. PERCENT works in both currencies as a
// ratio; FIXED_AMOUNT needs its own value per currency since 20 USD and 20
// COP are not comparable — a fixed code is only usable in a currency it has
// an amount configured for.
model PromoCode {
  id                String            @id @default(cuid())
  code              String            @unique
  description       String?
  discountType      PromoDiscountType @map("discount_type")
  percentOff        Int?              @map("percent_off")
  amountOffUsdMinor Int?              @map("amount_off_usd_minor")
  amountOffCopMinor Int?              @map("amount_off_cop_minor")
  isActive          Boolean           @default(true) @map("is_active")
  maxRedemptions    Int?              @map("max_redemptions")
  timesRedeemed     Int               @default(0) @map("times_redeemed")
  expiresAt         DateTime?         @map("expires_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  redemptions PromoCodeRedemption[]
  products    PromoCodeProduct[]

  @@map("promo_codes")
}

/// Productos a los que se limita un código.
///
/// La regla que sostiene todo esto: **sin filas, el código vale para todo**.
/// Así los códigos que ya estaban en circulación siguen funcionando igual, y
/// solo queda restringido aquel en el que alguien elige productos a propósito.
model PromoCodeProduct {
  promoCodeId String @map("promo_code_id")
  productId   String @map("product_id")

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, productId])
  @@index([productId])
  @@map("promo_code_products")
}

model PromoCodeRedemption {
  id            String   @id @default(cuid())
  promoCodeId   String   @map("promo_code_id")
  enrollmentId  String   @unique @map("enrollment_id")
  currency      String   @db.Char(3)
  discountMinor Int      @map("discount_minor")
  createdAt     DateTime @default(now()) @map("created_at")

  promoCode  PromoCode  @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([promoCodeId])
  @@map("promo_code_redemptions")
}

model TherapyPackage {
  id                 String   @id @default(cuid())
  enrollmentId       String   @unique @map("enrollment_id")
  totalSessions      Int      @map("total_sessions")
  usedSessions       Int      @default(0) @map("used_sessions")
  meetDefaultUrl     String?  @map("meet_default_url")
  reprogrammingNotes String?  @map("reprogramming_notes") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  enrollment Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sessions   TherapySession[]

  @@map("therapy_packages")
}

model TherapySession {
  id               String               @id @default(cuid())
  therapyPackageId String               @map("therapy_package_id")
  sessionNumber    Int                  @map("session_number")
  scheduledAt      DateTime?            @map("scheduled_at")
  durationMinutes  Int                  @default(60) @map("duration_minutes")
  status           TherapySessionStatus @default(SCHEDULED)
  meetUrl          String?              @map("meet_url")
  /// Evento de Google Calendar que representa esta sesión, si se sincronizó.
  /// Guardarlo hace que volver a sincronizar actualice el evento en vez de
  /// crear uno nuevo cada vez.
  googleEventId    String?              @map("google_event_id")
  clinicalNotes    String?              @map("clinical_notes") @db.Text
  completedAt      DateTime?            @map("completed_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  therapyPackage TherapyPackage        @relation(fields: [therapyPackageId], references: [id], onDelete: Cascade)
  notebookPages  ContactNotebookPage[]

  @@unique([therapyPackageId, sessionNumber])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@map("therapy_sessions")
}

model ContactNotebookPage {
  id               String                 @id @default(cuid())
  contactId        String                 @map("contact_id")
  title            String
  sortOrder        Int                    @map("sort_order")
  kind             NotebookPageKind       @default(CANVAS)
  background       NotebookPageBackground @default(BLANK)
  canvasData       Json?                  @map("canvas_data")
  canvasUrl        String?                @map("canvas_url")
  bodyText         String?                @map("body_text") @db.Text
  attachmentUrl    String?                @map("attachment_url")
  attachmentMime   String?                @map("attachment_mime")
  attachmentName   String?                @map("attachment_name")
  previewUrl       String?                @map("preview_url")
  therapySessionId String?                @map("therapy_session_id")
  enrollmentId     String?                @map("enrollment_id")
  createdByStaffId String?                @map("created_by_staff_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  contact        Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  therapySession TherapySession? @relation(fields: [therapySessionId], references: [id], onDelete: SetNull)
  enrollment     Enrollment?     @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  createdByStaff StaffUser?      @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([contactId, sortOrder])
  @@index([contactId, updatedAt(sort: Desc)])
  @@map("contact_notebook_pages")
}

model StaffUser {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  role            StaffRole @default(OPERATOR)
  isActive        Boolean   @default(true) @map("is_active")
  avatarUrl       String?   @map("avatar_url")
  themePreference String    @default("system") @map("theme_preference")
  notifyEmail     Boolean   @default(true) @map("notify_email")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  auditLogs                AuditLog[]
  messageLogs              MessageLog[]
  notebookPages            ContactNotebookPage[]
  staffSessions            StaffSession[]
  paymentVerificationCodes PaymentVerificationCode[]
  notificationRecipients   NotificationRecipient[]
  notificationPreferences  StaffNotificationPreference[]
  notificationDeliveries   NotificationDelivery[]
  assignedConversations    Conversation[]
  conversationMessages     ConversationMessage[]
  linkedChannelIdentities  ContactChannelIdentity[]
  socialAccounts           SocialAccount[]
  socialPosts              SocialPost[]
  googleAccounts           GoogleAccount[]
  paymentLinks             PaymentLink[]

  @@map("staff_users")
}

model StaffSession {
  id           String    @id @default(cuid())
  staffUserId  String    @map("staff_user_id")
  sessionToken String    @unique @map("session_token")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  deviceLabel  String?   @map("device_label")
  lastSeenAt   DateTime  @map("last_seen_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@index([expiresAt])
  @@map("staff_sessions")
}

model AuditLog {
  id          String   @id @default(cuid())
  staffUserId String?  @map("staff_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  changes     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  contacts ContactTag[]

  @@map("tags")
}

model ContactTag {
  contactId String   @map("contact_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@map("contact_tags")
}

model MessageTemplate {
  id          String       @id @default(cuid())
  key         String
  title       String       @default("")
  locale      String       @default("es")
  body        String       @db.Text
  productKind ProductKind? @map("product_kind")

  /// Metadatos de la plantilla equivalente aprobada en WhatsApp Cloud API.
  metaTemplateName   String? @map("meta_template_name")
  metaTemplateLang   String? @map("meta_template_lang")
  metaApprovalStatus String? @map("meta_approval_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messageLogs MessageLog[]

  @@unique([key, locale])
  @@map("message_templates")
}

model MessageLog {
  id           String         @id @default(cuid())
  contactId    String         @map("contact_id")
  templateId   String?        @map("template_id")
  staffUserId  String?        @map("staff_user_id")
  channel      MessageChannel @default(WHATSAPP_LINK)
  bodySnapshot String         @map("body_snapshot") @db.Text
  sentAt       DateTime       @default(now()) @map("sent_at")

  /// Estado de conversación de WhatsApp Cloud API (entrada y salida).
  direction         MessageDirection      @default(OUTBOUND)
  status            MessageDeliveryStatus @default(SENT)
  providerMessageId String?               @map("provider_message_id")
  waContextId       String?               @map("wa_context_id")
  mediaUrl          String?               @map("media_url")
  deliveredAt       DateTime?             @map("delivered_at")
  readAt            DateTime?             @map("read_at")
  failedReason      String?               @map("failed_reason")

  contact   Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  template  MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  staffUser StaffUser?       @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([contactId, sentAt])
  @@index([providerMessageId])
  @@map("message_logs")
}

model WebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventId     String          @map("event_id")
  processedAt DateTime        @default(now()) @map("processed_at")
  payload     Json?

  @@unique([provider, eventId])
  @@map("webhook_events")
}

/// Ingesta idempotente del webhook de Meta (WhatsApp, Messenger e Instagram).
///
/// `eventId` es el id del **mensaje** (`wamid…` / `mid…`), no el de la entrega:
/// Meta reintenta el mismo mensaje con envoltorios distintos, así que dedupear
/// por entrega dejaría pasar duplicados.
model MetaWebhookEvent {
  id          String   @id @default(cuid())
  /// Campo `object` de nivel superior: whatsapp_business_account | page | instagram.
  object      String
  eventId     String   @unique @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")
  payload     Json?

  @@map("meta_webhook_events")
}

/// Un hilo con una persona en un canal de Meta.
///
/// La identidad externa es la clave: teléfono (WhatsApp), PSID (Messenger) o
/// IGSID (Instagram). Instagram y Messenger no entregan teléfono ni correo, así
/// que `contactId` puede quedarse nulo indefinidamente — no es un error.
model Conversation {
  id               String              @id @default(cuid())
  channel          ConversationChannel
  externalThreadId String              @map("external_thread_id")
  /// Cuenta de Meta que recibió el mensaje (phone_number_id, page id o ig id).
  metaAccountId    String              @map("meta_account_id")

  contactId String? @map("contact_id")

  participantName      String? @map("participant_name")
  participantHandle    String? @map("participant_handle")
  participantAvatarUrl String? @map("participant_avatar_url")

  status          ConversationStatus @default(OPEN)
  assignedStaffId String?            @map("assigned_staff_id")

  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  /// Base de la ventana de 24 h de Meta. Nulo = el cliente nunca escribió.
  lastInboundAt DateTime? @map("last_inbound_at")
  unreadCount   Int       @default(0) @map("unread_count")

  /// Borrador del agente o del staff. Nunca se envía solo.
  draftBody      String?   @map("draft_body") @db.Text
  draftSource    String?   @map("draft_source")
  draftUpdatedAt DateTime? @map("draft_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contact       Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedStaff StaffUser?            @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages      ConversationMessage[]

  @@unique([channel, externalThreadId])
  @@index([status, lastMessageAt(sort: Desc)])
  @@index([contactId, lastMessageAt(sort: Desc)])
  @@index([assignedStaffId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMessage {
  id             String                @id @default(cuid())
  conversationId String                @map("conversation_id")
  direction      MessageDirection
  status         MessageDeliveryStatus @default(SENT)

  /// `wamid…` / `mid…` — clave de idempotencia frente a los reintentos de Meta.
  externalMessageId String? @unique @map("external_message_id")
  /// Mensaje al que responde (`context.id` en WhatsApp, `reply_to.mid` en Messenger).
  replyToExternalId String? @map("reply_to_external_id")

  body        String? @db.Text
  /// Adjuntos ya rehospedados en Blob — las URLs de Meta caducan.
  attachments Json?

  /// Presente solo cuando lo envió el staff desde el CRM.
  staffUserId String? @map("staff_user_id")
  /// Un mensaje que Meta nos devuelve porque se envió desde la app de Meta.
  isEcho      Boolean @default(false) @map("is_echo")

  sentAt       DateTime  @default(now()) @map("sent_at")
  deliveredAt  DateTime? @map("delivered_at")
  readAt       DateTime? @map("read_at")
  failedReason String?   @map("failed_reason")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  staffUser    StaffUser?   @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, sentAt])
  @@map("conversation_messages")
}

/// Una cuenta de red social conectada por OAuth.
///
/// Los tokens se guardan cifrados (lib/crypto/secret-box.ts): son credenciales
/// de publicación sobre la cuenta real, no datos de configuración.
model SocialAccount {
  id          String         @id @default(cuid())
  provider    SocialProvider
  /// Id estable de la cuenta en el proveedor (`open_id` en TikTok).
  externalId  String         @map("external_id")
  displayName String?        @map("display_name")
  username    String?
  avatarUrl   String?        @map("avatar_url")

  /// Nulo cuando la cuenta está desconectada. La fila sobrevive porque
  /// `SocialPost.account` cascadea: borrarla se llevaría el historial de
  /// publicaciones por delante.
  accessTokenEnc   String?   @map("access_token_enc") @db.Text
  /// En Meta guarda el token de usuario de larga duración. Meta no tiene
  /// `grant_type=refresh_token`, pero ese token es funcionalmente eso: es el
  /// que se vuelve a presentar para acuñar un token de Página nuevo.
  refreshTokenEnc  String?   @map("refresh_token_enc") @db.Text
  /// Caducidad del access token; por debajo se refresca antes de usarlo.
  expiresAt        DateTime? @map("expires_at")
  /// Caducidad del refresh token. Pasada, hay que reconectar a mano.
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  scopes           String?

  /// Falso cuando el proveedor revoca el permiso: la UI pide reconectar.
  isActive  Boolean @default(true) @map("is_active")
  lastError String? @map("last_error")

  /// Datos propios de cada proveedor: id de Página, id de la cuenta de
  /// Instagram, estado de la suscripción a webhooks. Json y no columnas porque
  /// cada proveedor guarda cosas distintas y nada de esto se filtra con `where`.
  metadata      Json?     @map("metadata")
  /// Última comprobación del token contra el proveedor.
  lastCheckedAt DateTime? @map("last_checked_at")

  connectedByStaffId String?  @map("connected_by_staff_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  connectedByStaff StaffUser?   @relation(fields: [connectedByStaffId], references: [id], onDelete: SetNull)
  posts            SocialPost[]

  @@unique([provider, externalId])
  @@map("social_accounts")
}

/// Una publicación programada o publicada en una red social.
model SocialPost {
  id        String           @id @default(cuid())
  accountId String           @map("account_id")
  mediaType SocialMediaType  @default(VIDEO) @map("media_type")
  status    SocialPostStatus @default(DRAFT)

  caption   String? @db.Text
  /// URLs en Blob. TikTok exige dominio verificado para PULL_FROM_URL, así que
  /// el publicador descarga de aquí y sube los bytes (FILE_UPLOAD).
  mediaUrls Json    @map("media_urls")

  /// PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY.
  /// Sin auditoría de TikTok solo se acepta SELF_ONLY.
  privacyLevel   String  @default("SELF_ONLY") @map("privacy_level")
  disableComment Boolean @default(false) @map("disable_comment")
  disableDuet    Boolean @default(false) @map("disable_duet")
  disableStitch  Boolean @default(false) @map("disable_stitch")

  scheduledAt DateTime? @map("scheduled_at")
  publishedAt DateTime? @map("published_at")

  /// `publish_id` del proveedor, para consultar el estado.
  externalPublishId String? @map("external_publish_id")
  externalPostId    String? @map("external_post_id")
  postUrl           String? @map("post_url")
  failedReason      String? @map("failed_reason")
  attemptCount      Int     @default(0) @map("attempt_count")

  createdByStaffId String?  @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  account        SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdByStaff StaffUser?    @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([accountId, createdAt(sort: Desc)])
  @@map("social_posts")
}

/// Puente entre un contacto del CRM y su identidad en cada canal. Es lo que
/// permite reconocer a la misma persona la próxima vez que escriba por
/// Instagram, donde no hay teléfono con el que emparejar.
/// Una cuenta de Google conectada desde /admin/ajustes/google.
///
/// Aquí no hay tokens: los guarda Vercel Connect y esta tabla solo lleva la
/// metadata que la UI necesita (a nombre de quién está, qué expone, si sigue
/// viva). Por eso no reutiliza `SocialAccount`, que sí cifra tokens propios y
/// cuelga de `SocialPost`.
model GoogleAccount {
  id String @id @default(cuid())

  /// Sujeto que se le pasa a Vercel Connect (`subject: { type: "user", id }`).
  ///
  /// Connect no soporta instalaciones multi-tenant en conectores OAuth
  /// propios, así que varias cuentas de Google se consiguen dando un sujeto
  /// distinto a cada una. El permiso de Google queda atado a este valor: si se
  /// regenera o se reutiliza, se pierde o se cruza el acceso.
  connectSubject String @unique @map("connect_subject")

  /// Se rellenan tras la primera autorización correcta; antes de eso la fila
  /// existe pero todavía no representa ninguna cuenta real.
  email       String?
  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")

  services GoogleService[]

  /// Falso mientras no se complete el consentimiento, y de nuevo cuando Connect
  /// dice que el permiso ya no existe. La UI ofrece reconectar en ambos casos.
  isActive  Boolean @default(false) @map("is_active")
  lastError String? @map("last_error")

  connectedByStaffId String?  @map("connected_by_staff_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  connectedByStaff StaffUser? @relation(fields: [connectedByStaffId], references: [id], onDelete: SetNull)

  @@index([isActive, createdAt(sort: Desc)])
  @@map("google_accounts")
}

model ContactChannelIdentity {
  id              String              @id @default(cuid())
  contactId       String              @map("contact_id")
  channel         ConversationChannel
  externalId      String              @map("external_id")
  displayName     String?             @map("display_name")
  linkedByStaffId String?             @map("linked_by_staff_id")
  createdAt       DateTime            @default(now()) @map("created_at")

  contact       Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  linkedByStaff StaffUser? @relation(fields: [linkedByStaffId], references: [id], onDelete: SetNull)

  @@unique([channel, externalId])
  @@index([contactId])
  @@map("contact_channel_identities")
}

model NotificationCampaign {
  id                String                     @id @default(cuid())
  name              String
  templateKey       String                     @map("template_key")
  channels          Json
  audience          String                     @default("ALL_CONTACTS")
  workshopEditionId String?                    @map("workshop_edition_id")
  status            NotificationCampaignStatus @default(DRAFT)
  totalTargets      Int                        @default(0) @map("total_targets")
  sentCount         Int                        @default(0) @map("sent_count")
  failedCount       Int                        @default(0) @map("failed_count")
  skippedCount      Int                        @default(0) @map("skipped_count")
  createdByStaffId  String?                    @map("created_by_staff_id")
  startedAt         DateTime?                  @map("started_at")
  completedAt       DateTime?                  @map("completed_at")
  createdAt         DateTime                   @default(now()) @map("created_at")

  /// Punto de reanudación keyset: hasta dónde llegó el envío por la audiencia,
  /// ordenada por `(createdAt, id)` ascendente. `null` = no empezada.
  ///
  /// Inngest memoriza el valor de retorno de cada `step.run`, así que el cursor
  /// se podría encadenar solo por ahí. Se persiste igualmente porque eso
  /// sobrevive a un cambio de versión de la función o a una cancelación
  /// manual, hace respondible «¿hasta dónde llegó?» desde el panel, y —lo que
  /// importa— se escribe en el **mismo** update que incrementa los contadores,
  /// así que posición y contadores no pueden discrepar.
  cursorAt        DateTime? @map("cursor_at")
  cursorContactId String?   @map("cursor_contact_id")

  workshopEdition WorkshopEdition?       @relation(fields: [workshopEditionId], references: [id], onDelete: SetNull)
  deliveries      NotificationDelivery[]

  @@index([createdAt])
  @@map("notification_campaigns")
}

model NotificationDelivery {
  id                     String                     @id @default(cuid())
  campaignId             String?                    @map("campaign_id")
  /// Opcional: los envíos dirigidos al staff no tienen contacto asociado.
  contactId              String?                    @map("contact_id")
  staffUserId            String?                    @map("staff_user_id")
  /// Enlaza el correo con el elemento del feed que lo originó.
  platformNotificationId String?                    @map("platform_notification_id")
  channel                MessageChannel
  status                 NotificationDeliveryStatus @default(PENDING)
  templateKey            String?                    @map("template_key")
  subject                String?
  bodySnapshot           String                     @map("body_snapshot") @db.Text
  recipient              String?
  providerId             String?                    @map("provider_id")
  errorMessage           String?                    @map("error_message") @db.Text
  sentAt                 DateTime?                  @map("sent_at")
  /// Confirmación del operador, no nuestra: la escribe el StatusCallback de
  /// Twilio. Es una columna y no un estado nuevo a propósito — un valor
  /// DELIVERED en el enum dejaría de contar como SENT en cada contador que ya
  /// existe (campaigns.ts, inngest/functions.ts, webinar-mailer.ts) y las
  /// estadísticas de campaña empezarían a reportar de menos en silencio.
  /// null = el proveedor no lo reporta, o todavía no llegó.
  deliveredAt            DateTime?                  @map("delivered_at")
  createdAt              DateTime                   @default(now()) @map("created_at")

  campaign             NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact              Contact?              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  staffUser            StaffUser?            @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  platformNotification PlatformNotification? @relation(fields: [platformNotificationId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([contactId, createdAt])
  @@index([staffUserId, createdAt])
  @@index([status, createdAt])
  // El registro de envíos filtra por canal; es la tabla de mayor cardinalidad
  // del esquema (una campaña de 100k por 2 canales escribe 200k filas).
  @@index([channel, createdAt])
  // El webhook de estado de Twilio busca por provider_id una o dos veces por
  // mensaje enviado, sobre esta misma tabla. Sin índice es un seq scan por
  // callback.
  @@index([providerId])
  @@map("notification_deliveries")
}

/// Un evento de la plataforma, guardado una sola vez. El fan-out por
/// destinatario vive en NotificationRecipient.
model PlatformNotification {
  id         String                @id @default(cuid())
  eventType  NotificationEventType @map("event_type")
  severity   NotificationSeverity  @default(INFO)
  title      String
  body       String?               @db.Text
  entityType String?               @map("entity_type")
  entityId   String?               @map("entity_id")
  /// Ruta interna a la que lleva la notificación (p. ej. /admin/contacts/abc).
  href       String?
  metadata   Json?
  createdAt  DateTime              @default(now()) @map("created_at")

  recipients NotificationRecipient[]
  deliveries NotificationDelivery[]

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([entityType, entityId])
  @@map("platform_notifications")
}

/// Fan-out: exactamente uno de staffUserId / contactId está presente. La
/// invariante se impone en emit.ts — Postgres no puede expresarla en un unique
/// porque NULL nunca colisiona.
model NotificationRecipient {
  id             String    @id @default(cuid())
  notificationId String    @map("notification_id")
  staffUserId    String?   @map("staff_user_id")
  contactId      String?   @map("contact_id")
  readAt         DateTime? @map("read_at")
  dismissedAt    DateTime? @map("dismissed_at")
  /// Marca de idempotencia del fan-out por correo.
  emailedAt      DateTime? @map("emailed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  notification PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  staffUser    StaffUser?           @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  contact      Contact?             @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([notificationId, staffUserId])
  @@unique([notificationId, contactId])
  @@index([staffUserId, createdAt(sort: Desc)])
  @@index([contactId, createdAt(sort: Desc)])
  @@map("notification_recipients")
}

/// Preferencias por evento. La ausencia de fila significa "usa el valor por
/// defecto del catálogo" — nunca se precrean filas.
model StaffNotificationPreference {
  id          String                @id @default(cuid())
  staffUserId String                @map("staff_user_id")
  eventType   NotificationEventType @map("event_type")
  inApp       Boolean               @default(true) @map("in_app")
  email       Boolean               @default(false)
  updatedAt   DateTime              @updatedAt @map("updated_at")

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, eventType])
  @@map("staff_notification_preferences")
}


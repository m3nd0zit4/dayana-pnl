# =============================================================================
# Dayana Beltrán PNL — variables de entorno (plantilla dev)
# Copia a .env y completa. Sincronizar desde Vercel Preview: bun run env:pull
#
# Local y rama dev en Vercel usan neondb_dev. Producción (main) usa neondb en Vercel Production.
# Guías: docs/dev-environment.md · docs/db-setup.md
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (Neon PostgreSQL)
#
# Usa DOS URLs en Neon (Dashboard → Connection details):
#
# 1) DIRECT_URL — conexión directa (migraciones, prisma db seed, Studio)
#    Host sin "-pooler", puerto 5432.
#    postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# [DEV] neondb_dev — pooler para la app; producción usa /neondb en Vercel Production
#    Host con "-pooler". NO uses channel_binding aquí (solo en DIRECT_URL).
#    postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1&connect_timeout=15
#
# Sin pgbouncer=true en el pooler verás errores "connection: Closed" tras idle o HMR.
# La app usa @prisma/adapter-neon (lib/db.ts) para reconectar ante sockets cerrados.
# -----------------------------------------------------------------------------
DIRECT_URL=
DATABASE_URL=

# -----------------------------------------------------------------------------
# CRM / Auth (panel /admin)
# -----------------------------------------------------------------------------
# Generar: openssl rand -base64 32 (obligatorio en producción)
AUTH_SECRET=

# Google OAuth para el portal de miembros (/miembros).
# Crear en Google Cloud Console → OAuth client (web). Redirect URI:
#   https://<dominio>/api/auth/callback/google
# Si faltan, el botón "Continuar con Google" se oculta y solo queda email+contraseña.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sesión staff: 30 días por dispositivo (configurado en auth.ts)
# [PRODUCTION REQUIRED] Rate limit distribuido (obligatorio en Vercel Production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Usuario OWNER inicial (bun run db:seed)
STAFF_OWNER_EMAIL=contacto@dayanabeltran.com
STAFF_OWNER_PASSWORD=
STAFF_OWNER_NAME=

# true = /admin sin login ni DB (solo local). false = login real con Neon
CRM_UI_PREVIEW=false

# -----------------------------------------------------------------------------
# Sitio público
# -----------------------------------------------------------------------------
# [PRODUCTION REQUIRED] https://dayanabeltran.com — en local/dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Analítica (Google Tag Manager)
#
# Un solo contenedor GTM cubre GA4 + Meta Pixel: ambos se configuran como tags
# dentro de GTM (leyendo eventos de dataLayer), no como scripts propios en el
# código. El contenedor solo carga tras aceptar cookies de analítica
# (ConsentBasedGtm.tsx, mismo patrón que Vercel Analytics).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GTM_CONTAINER_ID=

# -----------------------------------------------------------------------------
# Meta Pixel + Conversions API (CAPI)
#
# El Pixel corre en el navegador y pierde eventos por bloqueadores y
# restricciones de cookies; CAPI manda el mismo evento desde el servidor. Los
# dos usan el MISMO `event_id` (`purchase.<paymentId>`) para que Meta cuente
# una sola conversión — ver lib/meta/capi.ts.
#
# El id del píxel es público (va en el navegador). El token NO: es una
# credencial de escritura sobre el dataset de anuncios. Se puede guardar
# cifrado desde /admin/ajustes/integraciones, que gana sobre esta variable.
# Events Manager → Dataset → Settings → Conversions API → Generate access token
# -----------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=2561479411039598
META_CAPI_ACCESS_TOKEN=
# Solo para Events Manager → Test Events. Nunca definir en producción real:
# los eventos marcados con este código no cuentan como conversiones.
META_CAPI_TEST_EVENT_CODE=

# -----------------------------------------------------------------------------
# Mercado Pago
# https://www.mercadopago.com.co/developers/panel/credentials
# -----------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# USD = precios del sitio en dólares. Checkout MP Colombia siempre cobra en COP;
# con USD se convierte con MERCADOPAGO_USD_TO_COP al crear la preferencia.
MERCADOPAGO_CURRENCY=USD
# Referencia web + checkout MP (editable también en CRM → Productos)
MERCADOPAGO_USD_TO_COP=3500
MERCADOPAGO_SELLER_COUNTRY=CO
NEXT_PUBLIC_MERCADOPAGO_CURRENCY=USD
MERCADOPAGO_FEE_PERCENT=0.0475
MERCADOPAGO_FEE_FIXED=0
MERCADOPAGO_WEBHOOK_SECRET=   # [PRODUCTION REQUIRED]

# -----------------------------------------------------------------------------
# PayPal
# https://developer.paypal.com/dashboard/applications
# -----------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox              # [PRODUCTION: live] — controls API + SDK (via /api/paypal/sdk-config)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=    # [PRODUCTION: same as PAYPAL_CLIENT_ID]
PAYPAL_FEE_PERCENT=0.054
PAYPAL_FEE_FIXED=0.30
PAYPAL_WEBHOOK_ID=               # [PRODUCTION REQUIRED]

# -----------------------------------------------------------------------------
# Lemon Squeezy (merchant of record del checkout internacional)
# https://app.lemonsqueezy.com/settings/api
#
# LS asume impuestos, fraude, disputas y recibos, y acepta comercios desde
# Colombia — no hace falta entidad en EE. UU. Colombia sigue en Mercado Pago
# porque LS no tiene PSE, Nequi ni efectivo.
#
# Las dos banderas se encienden por separado a propósito: con la del servidor
# en true y la pública en false el endpoint funciona pero el botón no se pinta,
# que es como se verifica en producción sin exponerlo.
# -----------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=                       # Settings > API. Las claves de test y live NO se distinguen por prefijo
LEMONSQUEEZY_STORE_ID=                      # id numérico de la tienda
LEMONSQUEEZY_WEBHOOK_SECRET=                       # firma de /api/webhooks/lemonsqueezy
LEMONSQUEEZY_CHECKOUT_ENABLED=false         # true para aceptar /api/checkout/lemonsqueezy
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_ENABLED=false  # true para mostrar el botón (reemplaza a PayPal)
# Gross-up por petición vía custom_price: cambiarlos NO exige re-correr nada.
LEMONSQUEEZY_FEE_PERCENT=0.05
LEMONSQUEEZY_FEE_FIXED=0.50

# -----------------------------------------------------------------------------
# Stripe / Managed Payments
# https://dashboard.stripe.com/apikeys · https://dashboard.stripe.com/webhooks
#
# Managed Payments = Stripe/Link como merchant of record (impuestos, fraude,
# disputas y soporte los asume Stripe). Exige que la ubicación del negocio en
# Stripe esté en un país soportado — Colombia NO lo está.
#
# Es aditivo: sin STRIPE_CHECKOUT_ENABLED=true, PayPal y Mercado Pago siguen
# funcionando exactamente igual y no se muestra el botón de Stripe.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=                     # sk_test_… en pruebas, sk_live_… en producción
STRIPE_WEBHOOK_SECRET=                 # whsec_… del endpoint /api/webhooks/stripe
STRIPE_CHECKOUT_ENABLED=false          # true para aceptar /api/checkout/stripe
NEXT_PUBLIC_STRIPE_CHECKOUT_ENABLED=false  # true para mostrar el botón en la web
# Gross-up horneado en el Price de Stripe por scripts/stripe/setup-products.ts.
# Cambiarlos exige volver a correr ese script.
STRIPE_FEE_PERCENT=0.065
STRIPE_FEE_FIXED=0.30

# -----------------------------------------------------------------------------
# Vercel Blob (cuaderno clínico — dibujos, miniaturas y subidas PDF/imagen)
# https://vercel.com/docs/storage/vercel-blob
#
# Producción (automático): Vercel Dashboard → Storage → Blob → conecta el store
# al proyecto dayana-pnl. Vercel inyecta BLOB_STORE_ID + OIDC en cada deploy.
# No hace falta BLOB_READ_WRITE_TOKEN en env vars de Vercel si usas OIDC.
#
# Local: bun run env:pull  (Vercel Preview → .env)
# Alternativa local: pega BLOB_READ_WRITE_TOKEN desde el dashboard del store.
#
# Con Blob configurado el dibujo (JSON) se guarda en Blob y la DB solo guarda
# el puntero (canvas_url). Sin Blob, el dibujo cae a la DB como respaldo.
# Backfill de dibujos antiguos: bun --env-file=.env run scripts/migrate-canvas-to-blob.ts
# -----------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=   # opcional (local o fuera de Vercel)
# BLOB_STORE_ID=           # lo inyecta Vercel al conectar el store
# VERCEL_OIDC_TOKEN=       # lo inyecta Vercel (deploy) o env:pull (local)

# -----------------------------------------------------------------------------
# Agente CRM (eve) — panel de IA en /admin, solo OWNER
# Modelo: Gemini directo (capa gratuita, https://aistudio.google.com/apikey) —
# no pasa por Vercel AI Gateway, no requiere eve link ni AI_GATEWAY_API_KEY.
# -----------------------------------------------------------------------------
# CRM_AGENT_ENABLED=true requiere GEMINI_API_KEY: sin la clave el panel se
# muestra igual y falla en cada mensaje, sin error al arrancar.
# CRM_AGENT_ENABLED=true
# GEMINI_API_KEY=
# gemini-3.5-flash-lite no hace el paso de "thinking" ni acepta imágenes de
# forma confiable — ver el comentario en agent/agent.ts. gemini-3.5-flash
# (sin "-lite") sí hace ambas cosas y sigue en el tier gratis. Dejar vacío
# usa ese valor por defecto; solo fijarlo para probar otro modelo.
# GEMINI_MODEL=gemini-3.5-flash

# Solo desarrollo local: permite llamar al canal del agente sin cookie de staff
# (curl / eve CLI). Nunca definir en un despliegue — ver agent/channels/eve.ts.
# CRM_AGENT_LOCAL_DEV_AUTH=true

# -----------------------------------------------------------------------------
# Cuentas de Google (Calendario / Contactos / Drive) para el agente
#
# Los tokens los guarda Vercel Connect, no este proyecto. Antes de definir esto:
#   1. Cliente OAuth propio en Google Cloud (uno nuevo, NO reutilizar
#      AUTH_GOOGLE_ID, que es el acceso de miembros) con las APIs de Calendar,
#      People y Drive habilitadas.
#   2. `vercel connect create <url> --name google` (tipo Custom OAuth) y
#      `vercel connect attach oauth/google`.
#   3. `vercel env pull` para tener VERCEL_OIDC_TOKEN en local (caduca ~12 h).
#
# Aquí va el UID del conector, no una credencial. Las cuentas se conectan luego
# desde /admin/ajustes/google.
# -----------------------------------------------------------------------------
# GOOGLE_CONNECT_CONNECTOR=oauth/google

# [PRODUCTION REQUIRED — ambas claves]
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Notificaciones (correo, SMS, WhatsApp API)
# -----------------------------------------------------------------------------
NOTIFICATIONS_ENABLED=false      # [PRODUCTION: true]
NOTIFICATIONS_DRY_RUN=true       # [PRODUCTION: false]
NOTIFICATIONS_EMAIL_FROM=contacto@dayanabeltran.com
NOTIFICATIONS_EMAIL_FROM_NAME=Dayana Beltrán PNL

# Campana de notificaciones (feed en la app).
# Con STREAM_ENABLED en false el cliente hace polling cada 60s en vez de abrir
# un SSE. Es el interruptor de emergencia si la concurrencia de funciones o el
# costo se disparan: se puede cambiar desde Vercel sin desplegar.
NOTIFICATIONS_STREAM_ENABLED=false   # [PRODUCTION: true]
# Deja que el cron de retención borre NotificationDelivery de más de un año.
NOTIFICATIONS_PRUNE_DELIVERIES=false

# Correo — Resend (recomendado, dominio en Vercel). Ver docs/vercel-resend-email.md
RESEND_API_KEY=
# Firma de los webhooks de Resend (rebote/spam -> auto-suprime notifyEmail).
# Resend dashboard -> Webhooks -> Add endpoint -> /api/webhooks/resend -> copia el "Signing Secret" (whsec_...)
RESEND_WEBHOOK_SECRET=

# SMTP opcional (Gmail) si no usas Resend
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# SMS — Twilio
# El canal SMS ya está cableado entero y espera solo estas tres variables: con
# las tres puestas se enciende en todas partes a la vez —la tool send_contact_sms
# del asistente, el reparto de notificaciones de la plataforma y las campañas—
# sin tocar código y sin más despliegue que el propio cambio de entorno. Falta
# una sola y el canal queda inerte: los envíos se registran como SKIPPED y
# /admin/ajustes muestra cuál falta. TWILIO_FROM_NUMBER va en E.164 (+57...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Número dedicado al tráfico de marketing. Opcional: sin él, campañas y
# mensajes transaccionales salen del mismo número. Con él, una campaña (todo lo
# que lleva campaignId) sale por aquí y lo transaccional sigue por
# TWILIO_FROM_NUMBER — nunca al revés. En EE. UU. cada número se registra en su
# propia campaña 10DLC con su caso de uso, y esa separación es lo que evita que
# una infracción de marketing tumbe las confirmaciones de pago.
TWILIO_MARKETING_FROM_NUMBER=
# Base de la URL que firma los webhooks de Twilio. Solo hace falta si el dominio
# público no es NEXT_PUBLIC_SITE_URL: la firma cubre la URL tal como está
# configurada en la consola, y detrás del proxy de Vercel el host de la petición
# es el del deployment interno.
TWILIO_WEBHOOK_BASE_URL=
#
# Dos URLs para pegar en la consola de Twilio (Phone Numbers → el número →
# Messaging), una por cada número:
#   "A MESSAGE COMES IN" → POST https://<dominio>/api/webhooks/twilio
# El StatusCallback no se configura en la consola: se manda por mensaje desde el
# código, hacia https://<dominio>/api/webhooks/twilio/status

# WhatsApp Business Cloud API (Meta)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Id de la cuenta de WhatsApp Business (WABA), para gestionar plantillas.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Bandeja de entrada de Meta (WhatsApp + Instagram + Messenger)
# -----------------------------------------------------------------------------
# Los tres canales viven en la MISMA app de Meta y comparten una sola URL de
# callback: /api/webhooks/meta. El campo `object` del cuerpo distingue el origen.
#
# META_INBOX_ENABLED apaga la bandeja entera (rutas y página) sin desplegar:
# se puede subir el código a producción antes de que Meta apruebe la revisión.
META_INBOX_ENABLED=false
# Clave del HMAC de X-Hub-Signature-256. Sin ella, en producción se rechaza todo.
META_APP_SECRET=
META_APP_ID=
# Cadena a tu elección; Meta la repite en el handshake de suscripción.
META_WEBHOOK_VERIFY_TOKEN=
# La Página de Facebook sirve a la vez a Messenger y a Instagram: al estar la
# cuenta de IG vinculada a la Página, un único token cubre los dos canales.
# Genera el token desde un System User para que no caduque.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Id de la cuenta profesional de Instagram.
META_INSTAGRAM_ID=
# Opcional: fija la versión de la Graph API (por defecto v23.0).
# META_GRAPH_VERSION=

# -----------------------------------------------------------------------------
# Publicación en redes (TikTok) — /admin/contenido
# -----------------------------------------------------------------------------
# OJO con el alcance: TikTok NO tiene API de mensajes directos para una app
# normal (la Business Messaging API es beta y solo para partners homologados), y
# la API de comentarios exige advertiser_id, o sea que solo cubre anuncios. Por
# eso aquí solo hay publicación de contenido — no hay bandeja como la de Meta.
SOCIAL_PUBLISHING_ENABLED=false
# developers.tiktok.com → Manage apps → Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Por defecto <NEXT_PUBLIC_SITE_URL>/api/admin/social/tiktok/callback.
# Debe coincidir EXACTAMENTE con el Redirect URI registrado en TikTok.
# TIKTOK_REDIRECT_URI=
# Mientras esté en false, todo se publica en SELF_ONLY (privado) — es la regla
# de TikTok para apps sin auditar, no una decisión nuestra. Ponlo en true solo
# cuando aprueben la auditoría, o los envíos públicos fallarán.
TIKTOK_AUDITED=false

# Destinatario interno para el aviso de "nuevo lead" (uno u otro; LEAD_TO tiene prioridad).
NOTIFICATIONS_LEAD_TO=
NOTIFICATIONS_EMAIL_TO=

# Solo desarrollo local: fuerza el país detectado (bypassa x-vercel-ip-country)
# para probar precios/región sin desplegar. NO usar en producción.
FORCE_USER_COUNTRY=
